<?xml version="1.0" encoding="utf-8"?>
<!--
    Apparence du widget d'ecran d'accueil.

    Les identifiants (@+id/...) sont lus par CifiFournisseurWidget.kt :
    si vous les renommez, renommez-les aussi la-bas.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cifi_widget_racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/cifi_widget_fond"
    android:padding="14dp">

    <TextView
        android:id="@+id/cifi_widget_titre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CiFi Tech"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/cifi_widget_resume"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:text="Appuyez pour ouvrir l application."
        android:textColor="#E6FFFFFF"
        android:textSize="12sp"
        android:maxLines="3"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/cifi_widget_horodatage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#A6FFFFFF"
        android:textSize="10sp"
        android:maxLines="1" />
</LinearLayout>
