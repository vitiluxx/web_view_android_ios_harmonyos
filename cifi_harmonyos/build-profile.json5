{
  // ---------------------------------------------------------------------
  // Configuration de compilation du projet HarmonyOS.
  //
  // signingConfigs : laissez le tableau VIDE pour compiler un .hap de
  // debogage. Pour publier sur AppGallery, generez le profil dans
  // DevEco Studio (File > Project Structure > Signing Configs) : DevEco
  // remplira ce bloc lui-meme.
  // ---------------------------------------------------------------------
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "5.0.0(12)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": ["default"]
        }
      ]
    }
  ]
}
